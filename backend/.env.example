# Copy to .env and adjust. Every setting is optional.

CONVERTOR_ENVIRONMENT=development
CONVERTOR_STORAGE_DIR=./storage
CONVERTOR_FILE_TTL_MINUTES=60

# Limits (per request / per IP)
CONVERTOR_MAX_UPLOAD_MB=100
CONVERTOR_MAX_FILES_PER_REQUEST=20
CONVERTOR_MAX_PDF_PAGES=1000
CONVERTOR_RATE_LIMIT_PER_MINUTE=30
CONVERTOR_MAX_CONCURRENT_JOBS=4
CONVERTOR_JOB_TIMEOUT_SECONDS=300

# Set to true only when running behind a reverse proxy (nginx, Cloudflare, Render...)
CONVERTOR_TRUST_PROXY_HEADERS=false

# Frontend origins allowed to call the API (JSON list)
CONVERTOR_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173"]

# Optional explicit engine paths (auto-detected otherwise)
# CONVERTOR_LIBREOFFICE_PATH=C:\Program Files\LibreOffice\program\soffice.exe
# CONVERTOR_TESSDATA_PATH=C:Program FilesTesseract-OCR	essdata
# CONVERTOR_GHOSTSCRIPT_PATH=C:\Program Files\gs\gs10.04.0\bin\gswin64c.exe

# AI Summarizer / Translate PDF (disabled when empty)
ANTHROPIC_API_KEY=
